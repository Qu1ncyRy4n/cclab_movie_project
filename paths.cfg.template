# paths.cfg.template — tracked; defines video and MATLAB paths for each lab computer
# ----------------------------------------------------------------------------------
# Added 2026-07-14; updated 2026-07-22 to named per-machine sections.
#
# SETUP (one time per machine)
# ----------------------------
# 1. Copy this file to paths.cfg (same folder — it's gitignored).
# 2. In paths.cfg, set computer_name to the section below that matches this machine:
#
#      computer_name = lab_120
#
# 3. CONFI_freeviewingTraining_movie.m reads paths.cfg at startup and looks up
#    video_path for the named computer from this file automatically.
# 4. If this machine isn't listed below, add a [new_section] here and commit it.
#
#
# HOW TO MOUNT THE NAS
# --------------------
# Video files live on the NAS at:
#   \\cns-nas.ucdavis.edu\cclab\shared\Bliss-Moreau_Machado_Videos\video_ebm_dataset
#
# Windows : use the UNC path directly (no mounting needed), or map a drive:
#             File Explorer → "Map network drive" → \\cns-nas.ucdavis.edu\cclab\shared
#             Then use the assigned letter (e.g. Z:\...\video_ebm_dataset) as video_path.
# Mac     : Finder → Go → Connect to Server (Cmd-K) → smb://cns-nas.ucdavis.edu/cclab
#             Share mounts at /Volumes/cclab — use that prefix for video_path.
# Linux   : sudo mount -t cifs //cns-nas.ucdavis.edu/cclab /mnt/cclab \
#               -o username=YOUR_CAS_LOGIN,vers=3.0
#             Use /mnt/cclab as prefix.
#
#
# FIELDS
# ------
# video_path  — path to video_ebm_dataset/ (must contain video_all/)  [required]
# matlab_path — path to this repo on disk                             [documentation only]


# ── Lab Windows PCs (NAS over UNC) ──────────────────────────────────────────
[lab_120]
video_path  = \\cns-nas.ucdavis.edu\cclab\shared\Bliss-Moreau_Machado_Videos\video_ebm_dataset
matlab_path = C:\Users\qmryan\Desktop\cclab_movie_project

[lab_121]
